{
  "name": "design-foundry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/overlay-preview/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:document-persistence": "tsx scripts/verify-document-persistence.ts",
    "verify:ui-regressions": "tsx scripts/verify-ui-regressions.ts",
    "verify:render-ir-svg": "tsx scripts/verify-render-ir-svg.ts",
    "verify:text-shape": "tsx scripts/verify-text-shape.ts",
    "verify:operator-kernel": "tsx scripts/verify-operator-kernel.ts",
    "verify:render-canvas2d": "tsx scripts/verify-render-canvas2d.ts",
    "verify:halo-field-kernel": "tsx scripts/verify-halo-field-kernel.ts",
    "verify:render-pdf": "tsx scripts/verify-render-pdf.ts",
    "verify:display-list-adapter": "tsx scripts/verify-display-list-adapter.ts",
    "verify:visual-parity": "tsx scripts/verify-visual-parity.ts",
    "verify:export-geometry": "tsx examples/export-geometry-parity.ts",
    "demo:overlay-layout": "tsx examples/overlay-layout-demo.ts",
    "demo:copy-to-points": "tsx examples/copy-to-points-demo.ts",
    "demo:fuzzy-boids": "tsx examples/fuzzy-boids-demo.ts",
    "demo:orbits": "tsx examples/orbits-demo.ts",
    "demo:spokes": "tsx examples/spokes-demo.ts",
    "preview:dev": "vite --config apps/overlay-preview/vite.config.ts --host 127.0.0.1",
    "preview:build": "vite build --config apps/overlay-preview/vite.config.ts",
    "export:headless": "tsx scripts/export-headless.ts",
    "export:encode-mp4": "tsx scripts/encode-mp4.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.183.1",
    "playwright": "^1.58.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "sass": "^1.98.0",
    "three": "^0.183.2"
  }
}
